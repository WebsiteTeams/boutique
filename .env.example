# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ---------- Site ----------
# Public origin of the site (used for canonical URLs, sitemap, Open Graph, WhatsApp links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Database (libSQL / SQLite) ----------
# Local file in development. For production use a hosted libSQL database
# (e.g. Turso): DATABASE_URL=libsql://<db>.turso.io plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/uma.db
DATABASE_AUTH_TOKEN=

# ---------- First admin account (used only by `npm run db:seed`) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=UMA Admin

# ---------- Boutique contact details (shown across the site) ----------
# WhatsApp number with country code, digits only, e.g. 919876543210.
# "Chat with a Stylist" buttons are hidden until this is set.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=hello@umadesigners.in
NEXT_PUBLIC_ORDERS_EMAIL=orders@umadesigners.in
NEXT_PUBLIC_BOUTIQUE_ADDRESS=#12, Boutique Lane, T Nagar, Chennai 600017

# ---------- Social links (a link is hidden when its URL is empty) ----------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ---------- Payments: Razorpay (UPI, cards, net banking, wallets) ----------
# Without these, only Cash on Delivery is offered at checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured for the webhook pointing at /api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email: Resend (order, appointment and newsletter emails) ----------
# Without these, no emails are sent; admin notifications still appear in the dashboard.
RESEND_API_KEY=
EMAIL_FROM=UMA Designers <orders@umadesigners.in>
# Address that receives new order / appointment / enquiry alerts.
ADMIN_NOTIFY_EMAIL=

# ---------- Image storage ----------
# Cloudinary is used when all three are set; otherwise uploads are stored on
# local disk in UPLOAD_DIR (fine for a single server, not for serverless hosts).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=./data/uploads
